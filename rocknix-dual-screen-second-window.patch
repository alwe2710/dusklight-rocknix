+static void release_second_surface_locked() noexcept {
+  if (g_surface2) {
+    g_surface2.Unconfigure();
+  }
+  g_surface2 = {};
+  g_secondSurfaceConfigured = false;
+}
+
+bool create_second_surface() {
+  SDL_Window* window = window::get_second_sdl_window();
+  if (window == nullptr) {
+    Log.error("Failed to create second surface: no second window");
+    return false;
+  }
+  if (!g_instance || !g_adapter || !g_device) {
+    Log.error("Failed to create second surface: primary WebGPU device not ready yet");
+    return false;
+  }
+  window::SurfaceLock surfaceLock;
+  release_second_surface_locked();
+  g_surface2 = create_window_surface(g_instance, window, "SecondSurface");
+  if (!g_surface2) {
+    Log.error("Failed to create second surface");
+    return false;
+  }
+
+  const wgpu::Status status = g_surface2.GetCapabilities(g_adapter, &g_surfaceCapabilities2);
+  if (status != wgpu::Status::Success) {
+    Log.error("Failed to get second surface capabilities: {}", magic_enum::enum_name(status));
+    release_second_surface_locked();
+    return false;
+  }
+  if (g_surfaceCapabilities2.formatCount == 0 || g_surfaceCapabilities2.presentModeCount == 0) {
+    Log.error("Second surface has no formats/present modes");
+    release_second_surface_locked();
+    return false;
+  }
+  auto surfaceFormat = wgpu::TextureFormat::Undefined;
+  for (size_t i = 0; i < g_surfaceCapabilities2.formatCount; ++i) {
+    const auto format = to_linear(g_surfaceCapabilities2.formats[i]);
+    if (format == wgpu::TextureFormat::RGBA8Unorm || format == wgpu::TextureFormat::BGRA8Unorm) {
+      surfaceFormat = format;
+      break;
+    }
+  }
+  if (surfaceFormat == wgpu::TextureFormat::Undefined) {
+    surfaceFormat = g_surfaceCapabilities2.formats[0];
+  }
+  g_secondSurfacePresentMode = select_present_mode(g_surfaceCapabilities2);
+
+  int width = 0;
+  int height = 0;
+  ASSERT(SDL_GetWindowSizeInPixels(window, &width, &height), "Failed to get second window size: {}", SDL_GetError());
+  const wgpu::SurfaceConfiguration surfaceConfiguration{
+      .device = g_device,
+      .format = surfaceFormat,
+      .usage = wgpu::TextureUsage::RenderAttachment,
+      .width = static_cast<uint32_t>(width),
+      .height = static_cast<uint32_t>(height),
+      .presentMode = g_secondSurfacePresentMode,
+  };
+  g_surface2.Configure(&surfaceConfiguration);
+  g_secondSurfaceConfigured = true;
+  Log.info("Second surface configured: {}x{}, format {}", width, height, magic_enum::enum_name(surfaceFormat));
+  return true;
+}
+
+void release_second_surface() noexcept {
+  gfx::gpu_synchronize();
+  {
+    window::SurfaceLock surfaceLock;
+    release_second_surface_locked();
+  }
+}
+
+static wgpu::Sampler second_surface_sampler() {
+  if (!g_secondSurfaceSampler) {
+    const wgpu::SamplerDescriptor samplerDescriptor{
+        .label = "Second surface blit sampler",
+        .addressModeU = wgpu::AddressMode::ClampToEdge,
+        .addressModeV = wgpu::AddressMode::ClampToEdge,
+        .addressModeW = wgpu::AddressMode::ClampToEdge,
+        .magFilter = wgpu::FilterMode::Linear,
+        .minFilter = wgpu::FilterMode::Linear,
+        .mipmapFilter = wgpu::MipmapFilterMode::Linear,
+    };
+    g_secondSurfaceSampler = g_device.CreateSampler(&samplerDescriptor);
+  }
+  return g_secondSurfaceSampler;
+}
+
+void present_second_surface(wgpu::TextureView source, wgpu::TextureView overlaySource) {
+  if (!g_secondSurfaceConfigured || !g_surface2 || !g_device) {
+    return;
+  }
+
+  wgpu::SurfaceTexture surfaceTexture;
+  {
+    window::SurfaceLock surfaceLock;
+    g_surface2.GetCurrentTexture(&surfaceTexture);
+  }
+  if (surfaceTexture.status != wgpu::SurfaceGetCurrentTextureStatus::SuccessOptimal &&
+      surfaceTexture.status != wgpu::SurfaceGetCurrentTextureStatus::SuccessSuboptimal) {
+    return;
+  }
+  const auto view = surfaceTexture.texture.CreateView();
+
+  wgpu::BindGroup blitBindGroup;
+  if (source) {
+    const std::array bindGroupEntries{
+        wgpu::BindGroupEntry{.binding = 0, .sampler = second_surface_sampler()},
+        wgpu::BindGroupEntry{.binding = 1, .textureView = source},
+    };
+    const wgpu::BindGroupDescriptor bindGroupDescriptor{
+        .layout = g_CopyBindGroupLayout,
+        .entryCount = bindGroupEntries.size(),
+        .entries = bindGroupEntries.data(),
+    };
+    blitBindGroup = g_device.CreateBindGroup(&bindGroupDescriptor);
+  }
+
+  wgpu::BindGroup overlayBindGroup;
+  if (overlaySource) {
+    const std::array bindGroupEntries{
+        wgpu::BindGroupEntry{.binding = 0, .sampler = second_surface_sampler()},
+        wgpu::BindGroupEntry{.binding = 1, .textureView = overlaySource},
+    };
+    const wgpu::BindGroupDescriptor bindGroupDescriptor{
+        .layout = g_CopyBindGroupLayout,
+        .entryCount = bindGroupEntries.size(),
+        .entries = bindGroupEntries.data(),
+    };
+    overlayBindGroup = g_device.CreateBindGroup(&bindGroupDescriptor);
+  }
+
+  const std::array attachments{
+      wgpu::RenderPassColorAttachment{
+          .view = view,
+          .loadOp = wgpu::LoadOp::Clear,
+          .storeOp = wgpu::StoreOp::Store,
+          // Plain neutral gray backdrop -- a proper background image is a separate topic to
+          // revisit later (see docs/rocknix-porting.md Section E), not a black test-pattern
+          // fallback like Phase 1's solid magenta, but not a real background asset either.
+          .clearValue = wgpu::Color{0.25, 0.25, 0.25, 1.0},
+      },
+  };
+  const wgpu::RenderPassDescriptor renderPassDescriptor{
+      .label = "Second surface present",
+      .colorAttachmentCount = attachments.size(),
+      .colorAttachments = attachments.data(),
+  };
+  const wgpu::CommandEncoderDescriptor encoderDescriptor{.label = "Second surface command encoder"};
+  const auto encoder = g_device.CreateCommandEncoder(&encoderDescriptor);
+  const auto pass = encoder.BeginRenderPass(&renderPassDescriptor);
+  if (blitBindGroup) {
+    // Premultiplied-alpha blended on top: the offscreen pass this came from
+    // (aurora::gfx::create_pass, see src/m_Do/m_Do_graphic.cpp) clears to fully transparent, so
+    // only the minimap picture itself is opaque -- everywhere else lets the background show
+    // through instead of stamping out an opaque black square over it.
+    pass.SetPipeline(g_CopyPremultipliedAlphaPipeline);
+    pass.SetBindGroup(0, blitBindGroup, 0, nullptr);
+    pass.Draw(3);
+  }
+  if (overlayBindGroup) {
+    // Same premultiplied-alpha blit as `source` above, but sampled from a texture that's usually
+    // smaller than the second surface -- the full-screen triangle stretches it to fill the panel,
+    // which is exactly what gives the overlay its own scale factor independent of `source` (see
+    // mDoGph_drawLowerScreen in src/m_Do/m_Do_graphic.cpp, which sizes the offscreen pass this
+    // came from to get a uniform 1.5x for the item HUD).
+    pass.SetPipeline(g_CopyPremultipliedAlphaPipeline);
+    pass.SetBindGroup(0, overlayBindGroup, 0, nullptr);
+    pass.Draw(3);
+  }
+  pass.End();
+  const wgpu::CommandBufferDescriptor cmdBufDescriptor{.label = "Second surface command buffer"};
+  const auto buffer = encoder.Finish(&cmdBufDescriptor);
+  g_queue.Submit(1, &buffer);
+  {
+    window::SurfaceLock surfaceLock;
+    const auto status = g_surface2.Present();
+    if (!status) {
+      Log.warn("Second surface present failed");
+    }
+  }
+}
