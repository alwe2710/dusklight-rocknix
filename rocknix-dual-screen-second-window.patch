+// Fixed to the RG DS's panel resolution (each of its two DSI panels reports 640x480 to the
+// compositor, confirmed via `swaymsg -t get_outputs` on-device) rather than derived from
+// AuroraConfig's window size, which is sized for the primary/main-view window. Title is a fixed,
+// distinctive string so the packaging layer's compositor rule (see platforms/rocknix/dusklight.sh)
+// can match on it.
+bool create_second_window() {
+  const auto props = SDL_CreateProperties();
+  TRY(SDL_SetStringProperty(props, SDL_PROP_WINDOW_CREATE_TITLE_STRING, "Dusklight Lower Screen"),
+      "Failed to set {}: {}", SDL_PROP_WINDOW_CREATE_TITLE_STRING, SDL_GetError());
+  TRY(SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_X_NUMBER, SDL_WINDOWPOS_UNDEFINED), "Failed to set {}: {}",
+      SDL_PROP_WINDOW_CREATE_X_NUMBER, SDL_GetError());
+  TRY(SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_Y_NUMBER, SDL_WINDOWPOS_UNDEFINED), "Failed to set {}: {}",
+      SDL_PROP_WINDOW_CREATE_Y_NUMBER, SDL_GetError());
+  TRY(SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_WIDTH_NUMBER, 640), "Failed to set {}: {}",
+      SDL_PROP_WINDOW_CREATE_WIDTH_NUMBER, SDL_GetError());
+  TRY(SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_HEIGHT_NUMBER, 480), "Failed to set {}: {}",
+      SDL_PROP_WINDOW_CREATE_HEIGHT_NUMBER, SDL_GetError());
+  // SDL_WINDOW_BORDERLESS is belt-and-suspenders: window decoration is really the compositor's
+  // call under Wayland (see the packaging layer's `for_window ... border none` rule, which is the
+  // one that actually matters -- without it, the title bar/border eats into the panel's 640x480
+  // content area and cuts a visible notch out of the adjacent screen's edge).
+  TRY(SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_FLAGS_NUMBER,
+                            SDL_WINDOW_HIGH_PIXEL_DENSITY | SDL_WINDOW_BORDERLESS),
+      "Failed to set {}: {}", SDL_PROP_WINDOW_CREATE_FLAGS_NUMBER, SDL_GetError());
+  g_window2 = SDL_CreateWindowWithProperties(props);
+  if (g_window2 == nullptr) {
+    Log.error("Failed to create second window: {}", SDL_GetError());
+    return false;
+  }
+  TRY_WARN(SDL_ShowWindow(g_window2), "Failed to show second window: {}", SDL_GetError());
+  return true;
+}
+
+void destroy_second_window() {
+  if (g_window2 != nullptr) {
+    SDL_DestroyWindow(g_window2);
+    g_window2 = nullptr;
+  }
+}
